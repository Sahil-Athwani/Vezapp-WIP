# Copy this file to .env and fill it in. Never commit .env.
# ---- MySQL connection ----
VOICE_DB_HOST=
VOICE_DB_PORT=3306
VOICE_DB_USER=
VOICE_DB_PASSWORD=
VOICE_DB_NAME=
# SSL: rds = encrypted + verified for AWS RDS (recommended), true = verified with public CAs, false = off
VOICE_DB_SSL=false
# Only set to false if your host uses a self-signed SSL certificate
VOICE_DB_SSL_REJECT_UNAUTHORIZED=true
# Max connections per serverless instance
VOICE_DB_POOL_SIZE=5

# ---- App ----
# Per-app subscriptions: put the AppCode used in your Subscriptions table for each app.
# A company can then use that app only while it has a Subscriptions row with that AppCode covering today.
# Leave blank to let every company use the app.
APP_CODE_PATTERN_MASTER=
APP_CODE_MOULD_REPORTING=
APP_CODE_WIP=
# Secret that signs login sessions. Keep private. At least 32 characters.
AUTH_SECRET=

# ---- Wispr Flow speech-to-text (optional) ----
# API key from Wispr Flow. Leave blank to use the browser's built-in speech recognition.
WISPR_API_KEY=
# Language code sent to Wispr (ISO 639-1)
WISPR_LANGUAGE=en

# ---- Google Cloud Speech-to-Text (recommended for accuracy) ----
# API key from Google Cloud with the Speech-to-Text API enabled. Primed with field, pattern and part names.
GOOGLE_STT_API_KEY=
# Recognition language (en-IN = English, India)
GOOGLE_STT_LANGUAGE=en-IN
